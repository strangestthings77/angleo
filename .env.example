NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=https://angleo.pl

# Cal.com API v2 — server only, never NEXT_PUBLIC_. Settings → Developer → API keys.
CAL_API_KEY=
# Numeric id of the lesson event type (GET /v2/event-types?username=…)
CAL_EVENT_TYPE_ID=

# Supabase (student area). Publishable key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
